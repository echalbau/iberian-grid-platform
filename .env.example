# Copy to .env (`make up` does it for you if .env is missing). Never commit .env.
# The values below are local-development defaults for the Docker stack only.

# --- Lakehouse storage -------------------------------------------------------
LAKEHOUSE_BUCKET=iberian-grid-lakehouse
# MinIO endpoint as seen from the host. Leave empty to talk to real AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
AWS_REGION=eu-south-2

# --- Credentials (MinIO root user locally; an IAM identity on AWS) -----------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-locally

# --- Data sources ------------------------------------------------------------
# ENTSO-E Transparency Platform security token (request it from ENTSO-E).
# REData and Open-Meteo need no key.
ENTSOE_API_TOKEN=

# --- Airflow (local stack only) ----------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change-me-locally
# Any random strings; shared by the Airflow components of the local stack.
AIRFLOW_JWT_SECRET=change-me-locally
AIRFLOW_FERNET_KEY=

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
